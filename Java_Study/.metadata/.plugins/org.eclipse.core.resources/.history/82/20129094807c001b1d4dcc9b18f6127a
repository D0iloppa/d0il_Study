package random_lotto;

public static class Inc_Sort {
	public static Inc_Sort sort = new Inc_Sort();
	private Inc_Sort() {};
	
	public int[] sort(int[] a) {
		
		for (int i = 0; i < a.length; i++) {
	    	for (int j = 0; j < i; j++)
	            if (a[i] < a[j]) {
	                int tmp = a[i]; a[i] = a[j]; a[j] = tmp;
	            }
	    }
		
		return a;
		
	}
	
}
