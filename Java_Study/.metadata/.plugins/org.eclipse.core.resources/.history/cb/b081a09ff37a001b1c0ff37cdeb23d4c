package PhoneBookManager_ex;

public class PhoneInfo {
	
	String name;
	String phoneNumber;
	
	public PhoneInfo(String name, String num){
		this.name = name;
		this.phoneNumber = num;
	}
	
	public void showPhoneInfo(){
		System.out.println("name: "+ name);
		System.out.println("phone: " + phoneNumber);
	}

}
